{
  "name": "Dev Container",
  "dockerFile": "Dockerfile",
  "context": "..",
  "workspaceMount": "source=${localWorkspaceFolder},target=/home/ubuntu/ws_ros/src/nortek_dvl,type=bind",
  "workspaceFolder": "/home/ubuntu/ws_ros/src/nortek_dvl",
  "remoteUser": "ubuntu",
  "runArgs": [
    "--network=host",
    "--cap-add=SYS_PTRACE",
    "--security-opt=seccomp:unconfined",
    "--security-opt=apparmor:unconfined",
    "--volume=/dev:/dev",
    "--privileged"
  ],
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-azuretools.vscode-docker",
        "ms-python.python",
        "njpwerner.autodocstring",
        "ms-vscode.cpptools",
        "redhat.vscode-xml",
        "redhat.vscode-yaml",
        "smilerobotics.urdf",
        "DavidAnson.vscode-markdownlint",
        "xaver.clang-format",
        "charliermarsh.ruff",
        "ms-vscode.cmake-tools",
        "ms-vscode.cpptools-extension-pack"
      ]
    }
  }
}
